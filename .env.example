# Supabase Postgres
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@<direct-host>:5432/postgres"

# NextAuth (generate NEXTAUTH_SECRET with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps (Embed API for place detail pages; JS SDK added in Step 5)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
